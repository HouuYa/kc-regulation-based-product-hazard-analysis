{
  "name": "kc-hazard-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "KC안전기준 기반 제품위해 심층분석 체계 — 0단계(개념검증)",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "cross-env NODE_OPTIONS=--use-system-ca next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/db-push.ts",
    "codebook:load": "tsx codebook/scripts/load-codebook.ts",
    "codebook:inspect": "tsx codebook/scripts/inspect-codebook.ts",
    "standards:inspect": "tsx scripts/inspect-standards.ts",
    "standards:load": "tsx scripts/load-standards.ts",
    "tag": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tag-clauses.ts",
    "embed": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/embed-clauses.ts",
    "search": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/search.ts",
    "eval": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/eval.ts",
    "codebook:emit": "tsx codebook/scripts/emit-codebook-sql.ts",
    "standards:sync": "tsx scripts/sync-standards.ts",
    "cases:load": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/load-cases.ts",
    "standards:roles": "tsx scripts/backfill-roles.ts",
    "scopes:seed": "tsx scripts/seed-scopes.ts",
    "cases:code": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tag-cases.ts",
    "recalls:fetch": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/load-recalls.ts",
    "recalls:code": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tag-cases.ts --source-type RECALL_OVERSEAS --all",
    "recalls:analyze": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/analyze-recall.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.0",
    "openai": "^6.2.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "unpdf": "^1.3.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
