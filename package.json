{
  "name": "kc-hazard-analysis",
  "version": "0.1.0",
  "private": true,
  "description": "KC안전기준 기반 제품위해 심층분석 체계 — 0단계(개념검증)",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "build": "cross-env NODE_OPTIONS=--use-system-ca next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:bundle": "tsx scripts/check-client-bundle.ts",
    "db:push": "tsx scripts/db-push.ts",
    "codebook:load": "tsx codebook/scripts/load-codebook.ts",
    "codebook:inspect": "tsx codebook/scripts/inspect-codebook.ts",
    "standards:inspect": "tsx scripts/inspect-standards.ts",
    "standards:load": "tsx scripts/load-standards.ts",
    "standards:title": "tsx scripts/backfill-standard-title.ts",
    "tag": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tag-clauses.ts",
    "embed": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/embed-clauses.ts",
    "embed:secret": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/set-db-secret.ts openai",
    "embed:status": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/embed-status.ts",
    "ops:secret": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/set-db-secret.ts ops",
    "ops:test": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/set-db-secret.ts test",
    "search": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/search.ts",
    "eval": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/eval.ts",
    "eval:build-key": "tsx scripts/build-answer-key.ts",
    "eval:compare": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/compare-testitems.ts",
    "eval:second-opinion": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/eval-second-opinion.ts",
    "codebook:emit": "tsx codebook/scripts/emit-codebook-sql.ts",
    "standards:sync": "tsx scripts/sync-standards.ts",
    "cases:load": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/load-cases.ts",
    "standards:roles": "tsx scripts/backfill-roles.ts",
    "scopes:seed": "tsx scripts/seed-scopes.ts",
    "scopes:seed-terms": "tsx scripts/seed-scope-terms.ts",
    "cases:code": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tag-cases.ts",
    "cases:rescope": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/rescope-cases.ts",
    "cases:second-opinion": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/second-opinion.ts",
    "photos:reanalyze": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/reanalyze-photos.ts",
    "recalls:fetch": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/load-recalls.ts",
    "recalls:code": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tag-cases.ts --source-type RECALL_OVERSEAS --all",
    "recalls:analyze": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/analyze-recall.ts",
    "gpc:load": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/load-gpc.ts",
    "standards:gpc": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/tag-standards-gpc.ts",
    "terms:gpc": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/assign-term-gpc.ts",
    "standards:link-tests": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/link-test-methods.ts",
    "cause:build": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/build-cause-bridge.ts",
    "scope:suggest": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/suggest-scope.ts",
    "taxonomy:load": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/load-taxonomy.ts",
    "keywords:load": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/load-item-keywords.ts",
    "alias:eval": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/eval-alias.ts",
    "alias:build": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/build-aliases.ts",
    "scopes:embed": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/embed-scopes.ts",
    "taxonomy:link": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/link-taxonomy-standards.ts",
    "link:eval": "cross-env NODE_OPTIONS=--use-system-ca tsx scripts/eval-link.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.0",
    "openai": "^6.2.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "unpdf": "^1.3.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
