# ===============================================================
# 환경변수 템플릿 (커밋 대상 — 실제 키 없음)
# .env.local 로 복사한 뒤 실제 값을 채우세요. 이 파일에는 실제 키를 넣지 마세요.
# ===============================================================

# ---------------------------------------------------------------
# LLM · 임베딩 (L1 태깅 / L2 코드화 / L3 임베딩 / L3.5 리랭킹)
#   ↓↓↓ 승호님이 직접 채워 주세요 ↓↓↓
# ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# 2단 태깅 (실측: Luna 3회 /usr/bin/bash.00222 < Terra 1회 /usr/bin/bash.00740 — 싼 모델 반복이 3.3배 싸다)
#   1차: 전량 태깅. 반복해서 일치도를 얻는다
OPENAI_BULK_MODEL=gpt-5.6-luna
OPENAI_BULK_EFFORT=low
#   2차: 1차가 흔들린 건만 승격
OPENAI_ESCALATE_MODEL=gpt-5.6-terra
OPENAI_ESCALATE_EFFORT=medium
#   리랭킹: 분석 1회에 후보 20건뿐 — 비용보다 품질
OPENAI_RERANK_MODEL=gpt-5.6-terra
OPENAI_RERANK_EFFORT=low
# 임베딩: 3-large 를 1536 으로 잘라 쓴다(Matryoshka). 스키마 vector(1536) 유지.
#   실측 분리도 3-small 0.10 → 3-large@1536 0.29
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=1536

# ---------------------------------------------------------------
# 국내 리콜 API (한국제품안전협회)
# ---------------------------------------------------------------
DOMESTIC_RECALL_API_KEY=oecd_live_...
# base URL 미확인 — 확인되면 채울 것
DOMESTIC_RECALL_API_BASE_URL=

# ---------------------------------------------------------------
# 해외 리콜 API (Recall Hub)
#   인증: Authorization: Bearer <key>  또는  X-API-Key: <key>
#   외부 키는 승인(approved) 건만 조회 가능 — 설계문서 0.2 방안 A
# ---------------------------------------------------------------
RECALL_HUB_API_KEY=rh_live_...
RECALL_HUB_API_BASE_URL=https://recall-hub-admin-dev.vercel.app

# ---------------------------------------------------------------
# Supabase (조직 gdjcxdfwizpposdbqtko 프로젝트 생성 후 채움)
#   SERVICE_ROLE 키는 서버 전용 — 브라우저로 절대 노출 금지
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# DDL 적용용 직접 연결 문자열 (Supabase 대시보드 > Connect > Session pooler)
DATABASE_URL=

# ---------------------------------------------------------------
# 태깅 파라미터 (설계문서 결정항목 9·10·14)
# ---------------------------------------------------------------
# 1차 반복 호출 횟수 (결정항목 14)
TAGGING_BULK_REPEAT=3
# 이 일치도 미만이면 상위 모델로 승격. 1.0 = 만장일치 아니면 승격
TAGGING_ESCALATE_BELOW_AGREEMENT=1.0
# 검색용 텍스트 조립 규칙 변형 (결정항목 9) — A|B|C
SEARCH_TEXT_VARIANT=A
# RRF 융합 파라미터 (결정항목 10) — 하드코딩 금지, 0단계 실측 후 조정
RRF_K=60
RRF_WEIGHT_CODE=0.5
RRF_WEIGHT_CODE_PARTIAL=0.2
