# ===============================================================
# 환경변수 템플릿 (커밋 대상 — 실제 키 없음)
# .env.local 로 복사한 뒤 실제 값을 채우세요. 이 파일에는 실제 키를 넣지 마세요.
# ===============================================================

# ---------------------------------------------------------------
# LLM · 임베딩 (L1 태깅 / L2 코드화 / L3 임베딩 / L3.5 리랭킹)
#   ↓↓↓ 승호님이 직접 채워 주세요 ↓↓↓
# ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# 2단 태깅 (실측: Luna 3회 /usr/bin/bash.00222 < Terra 1회 /usr/bin/bash.00740 — 싼 모델 반복이 3.3배 싸다)
#   1차: 전량 태깅. 반복해서 일치도를 얻는다
OPENAI_BULK_MODEL=gpt-5.6-luna
OPENAI_BULK_EFFORT=low
#   2차: 1차가 흔들린 건만 승격
OPENAI_ESCALATE_MODEL=gpt-5.6-terra
OPENAI_ESCALATE_EFFORT=medium
#   리랭킹: 분석 1회에 후보 20건뿐 — 비용보다 품질
OPENAI_RERANK_MODEL=gpt-5.6-terra
OPENAI_RERANK_EFFORT=low
# 임베딩: 3-large 를 1536 으로 잘라 쓴다(Matryoshka). 스키마 vector(1536) 유지.
#   실측 분리도 3-small 0.10 → 3-large@1536 0.29
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=1536
#   사고조사보고서 첨부사진 분석(비전): 연 50건 안팎 — 최상위 모델까진 필요 없음, escalate와 같은 급
OPENAI_VISION_MODEL=gpt-5.6-terra
OPENAI_VISION_EFFORT=medium

# ---------------------------------------------------------------
# GPC(GS1 국제 품목분류) 조회 — 협회의 별도 Supabase 프로젝트 벡터 색인을 RPC로 직접 부른다
# ---------------------------------------------------------------
GPC_LOOKUP_URL=https://fczencruxulddednkint.supabase.co
GPC_LOOKUP_ANON_KEY=

# ---------------------------------------------------------------
# 국내 리콜 API (한국제품안전협회)
# ---------------------------------------------------------------
DOMESTIC_RECALL_API_KEY=oecd_live_...
# base URL 미확인 — 확인되면 채울 것
DOMESTIC_RECALL_API_BASE_URL=

# ---------------------------------------------------------------
# (미사용 — 2026-09-02 부터 아래 RECALL_SOURCE_* 직접 접근으로 대체됨)
# 해외 리콜 얇은 REST API (Recall Hub, 16개 필드만 제공)
# ---------------------------------------------------------------
RECALL_HUB_API_KEY=rh_live_...
RECALL_HUB_API_BASE_URL=https://recall-hub-admin-dev.vercel.app

# ---------------------------------------------------------------
# Supabase (조직 gdjcxdfwizpposdbqtko 프로젝트 생성 후 채움)
#   SERVICE_ROLE 키는 서버 전용 — 브라우저로 절대 노출 금지
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# DDL 적용용 직접 연결 문자열 (Supabase 대시보드 > Connect > Session pooler)
DATABASE_URL=

# ---------------------------------------------------------------
# 해외 리콜 원본 표 직접 접근 (Recall Hub 관리자 시스템의 Supabase, 별도 프로젝트)
#   협회 담당자가 승인·분류(HF/DT)까지 마친 recalls 표를 직접 읽는다.
#   RECALL_HUB_API_KEY(위 얇은 REST API, 16개 필드)를 대체한다 — 2026-09-02 결정.
# ---------------------------------------------------------------
RECALL_SOURCE_SUPABASE_URL=
RECALL_SOURCE_SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------
# 태깅 파라미터 (설계문서 결정항목 9·10·14)
# ---------------------------------------------------------------
# 1차 반복 호출 횟수 (결정항목 14)
TAGGING_BULK_REPEAT=3
# 이 일치도 미만이면 상위 모델로 승격. 1.0 = 만장일치 아니면 승격
TAGGING_ESCALATE_BELOW_AGREEMENT=1.0
# 검색용 텍스트 조립 규칙 변형 (결정항목 9) — A|B|C
SEARCH_TEXT_VARIANT=A
# RRF 융합 파라미터 (결정항목 10) — 하드코딩 금지, 0단계 실측 후 조정
RRF_K=60
RRF_WEIGHT_CODE=0.5
RRF_WEIGHT_CODE_PARTIAL=0.2

# ---------------------------------------------------------------
# 배포 사이트 외부 차단 (2026-09-02 추가) — SITE_AUTH_PASSWORD 를 비워 두면
# (로컬 개발 등) middleware.ts 가 그대로 통과시킨다.
#   Netlify Free 플랜엔 자체 비밀번호 보호 기능이 없어 middleware.ts로 직접
#   Basic Auth를 구현했다. SITE_AUTH_USERNAME 을 비워 두면 사용자이름은
#   검증하지 않고 통과(아무 값이나 입력해도 됨), 채우면 그 값까지 검증한다.
# ---------------------------------------------------------------
SITE_AUTH_USERNAME=
SITE_AUTH_PASSWORD=

# ---------------------------------------------------------------
# 운영 알림 (2026-09-03 추가) — 자동 배치에 문제가 생기면 텔레그램으로 알린다.
#   값을 채운 뒤 `npm run ops:secret` 을 한 번 실행해야 반영된다.
#   알림은 DB 안에서(pg_cron) 보내므로, DB 금고(Vault)에 넣어야 하기 때문이다.
#   토큰은 텔레그램 @BotFather 에서 봇을 만들면 나온다.
#   CHAT_ID 를 비워 두면 docs/n8nErrorTrigger/Error Trigger.json 이 쓰던
#   대화 번호(5185533472)를 그대로 쓴다.
#
#   이 둘은 Netlify 에 등록하지 않는다. 알림을 보내는 주체가 웹사이트가 아니라
#   DB(pg_cron)라서 배포 환경에는 필요가 없고, 등록하면 오히려 배포가 막힌다 —
#   Netlify 시크릿 스캔은 등록된 환경변수 값을 저장소 전체에서 찾는데, 위 대화
#   번호가 이 파일과 n8n 참고 파일에 그대로 적혀 있기 때문이다(라운드 13·14와
#   같은 오탐). 값은 로컬 .env.local 에만 두고 npm run ops:secret 으로 금고에 넣는다.
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
